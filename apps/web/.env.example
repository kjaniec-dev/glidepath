# Base URL of the glidepath FastAPI service.
# Local dev: uv run --package glidepath-api uvicorn glidepath_api:app --port 8000
# Local dev (direct to FastAPI, no nginx):
VITE_API_URL=http://localhost:8000

# Docker Compose / nginx reverse proxy — leave empty so calls are same-origin:
# VITE_API_URL=
